# ==============================================
# Blockchain Indexer - Environment Variables
# ==============================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# Database (used by docker-compose)
DB_PASSWORD=postgres

# Alchemy RPC URLs (primary)
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ARBITRUM_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Infura RPC URLs (failover)
INFURA_ETH_URL=https://mainnet.infura.io/v3/YOUR_KEY
INFURA_POLYGON_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
INFURA_ARBITRUM_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_KEY

# pgAdmin (optional - only with `docker compose --profile tools up`)
PGADMIN_PASSWORD=admin
